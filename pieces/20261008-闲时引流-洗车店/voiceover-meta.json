{
  "status": "ready",
  "shots": {
    "1": {
      "duration": 14.201791666666667,
      "captions": [
        {
          "text": "洗车店老周碰到个难题：",
          "start": 0,
          "end": 2.625
        },
        {
          "text": "工作日白天工位全空着，",
          "start": 2.625,
          "end": 4.910042
        },
        {
          "text": "一到周末反倒排长队。",
          "start": 4.910042,
          "end": 6.7750835
        },
        {
          "text": "他没打算打折，",
          "start": 6.7750835,
          "end": 8.015083
        },
        {
          "text": "而是发了一张",
          "start": 8.015083,
          "end": 8.865084
        },
        {
          "text": "只在工作日白天能用的券。",
          "start": 8.865084,
          "end": 11.225125
        },
        {
          "text": "那空着的这段时间，",
          "start": 11.225125,
          "end": 12.755125
        },
        {
          "text": "怎么让人愿意来？",
          "start": 12.755125,
          "end": 14.201791666666667
        }
      ],
      "signature": "956813ca06d88eb730a23c344b63f0cc57e32485983af5bf8b0790e4a62d10c4",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "2": {
      "duration": 17.461875,
      "captions": [
        {
          "text": "发券和打折，",
          "start": 0,
          "end": 1.625
        },
        {
          "text": "差的不是有没有优惠，",
          "start": 1.625,
          "end": 3.425
        },
        {
          "text": "是优惠给在什么时间。",
          "start": 3.425,
          "end": 5.5650415
        },
        {
          "text": "打折是不分时段都便宜，",
          "start": 5.5650415,
          "end": 7.745042
        },
        {
          "text": "人照样都挤在周末。",
          "start": 7.745042,
          "end": 9.630083
        },
        {
          "text": "他动的是券能用的时间——",
          "start": 9.630083,
          "end": 11.885083
        },
        {
          "text": "工作日白天管用，",
          "start": 11.885083,
          "end": 13.415083
        },
        {
          "text": "别的时候不行。",
          "start": 13.415083,
          "end": 14.710125
        },
        {
          "text": "价目表一分没动，",
          "start": 14.710125,
          "end": 16.215124
        },
        {
          "text": "动的只是时间。",
          "start": 16.215124,
          "end": 17.461875
        }
      ],
      "signature": "96f4b1739e942b8169eb129dee07f9260642c219d105e2734c7cc94a9dbde575",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "3": {
      "duration": 16.402333333333335,
      "captions": [
        {
          "text": "顾客和老板，",
          "start": 0,
          "end": 1.575
        },
        {
          "text": "为什么都愿意？",
          "start": 1.575,
          "end": 3.0350418
        },
        {
          "text": "顾客这边很简单：",
          "start": 3.0350418,
          "end": 4.535042
        },
        {
          "text": "工作日白天来不用排队，",
          "start": 4.535042,
          "end": 6.575042
        },
        {
          "text": "哪天来还能自己挑。",
          "start": 6.575042,
          "end": 8.415083
        },
        {
          "text": "老板这边更实在：",
          "start": 8.415083,
          "end": 9.935083
        },
        {
          "text": "工位空一天，",
          "start": 9.935083,
          "end": 10.985084
        },
        {
          "text": "房租和工资一分不少，",
          "start": 10.985084,
          "end": 13.030125
        },
        {
          "text": "多洗一辆就多一份收入，",
          "start": 13.030125,
          "end": 14.965124
        },
        {
          "text": "周末的客人也没丢。",
          "start": 14.965124,
          "end": 16.402333333333335
        }
      ],
      "signature": "c266da648e5f89bdfad9d0ff913dd6a5665c1ef257a095e5abece3e0bcd54595",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "4": {
      "duration": 16.66925,
      "captions": [
        {
          "text": "跑起来就四步。",
          "start": 0,
          "end": 2.2200418
        },
        {
          "text": "先做券，",
          "start": 2.2200418,
          "end": 3.0150418
        },
        {
          "text": "把能用的时间定在工作日白天；",
          "start": 3.0150418,
          "end": 5.9000835
        },
        {
          "text": "再定领取时间，",
          "start": 5.9000835,
          "end": 7.4450836
        },
        {
          "text": "比如每天上午九点放出来，",
          "start": 7.4450836,
          "end": 9.735084
        },
        {
          "text": "领取页上挂着倒计时；",
          "start": 9.735084,
          "end": 11.780125
        },
        {
          "text": "顾客把券领走；",
          "start": 11.780125,
          "end": 13.180166
        },
        {
          "text": "到店出示，",
          "start": 13.180166,
          "end": 14.075167
        },
        {
          "text": "店员核销，",
          "start": 14.075167,
          "end": 15.115166
        },
        {
          "text": "这张券就算用掉了。",
          "start": 15.115166,
          "end": 16.66925
        }
      ],
      "signature": "b8a15783f07c303539fbc3029786e23d1bf0d89ee1e9fe551008504989ec2772",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "5": {
      "duration": 13.975333333333333,
      "captions": [
        {
          "text": "真正定成败的，",
          "start": 0,
          "end": 1.675
        },
        {
          "text": "是那张券的时间范围。",
          "start": 1.675,
          "end": 3.7600417
        },
        {
          "text": "设成全天都能用，",
          "start": 3.7600417,
          "end": 5.205042
        },
        {
          "text": "顾客照样挑周末上门，",
          "start": 5.205042,
          "end": 7.1950417
        },
        {
          "text": "闲时依旧没人。",
          "start": 7.1950417,
          "end": 8.825083
        },
        {
          "text": "把时间卡在工作日白天，",
          "start": 8.825083,
          "end": 10.905083
        },
        {
          "text": "顾客才会真的挪到",
          "start": 10.905083,
          "end": 12.205083
        },
        {
          "text": "你想要的那段闲时来。",
          "start": 12.205083,
          "end": 13.975333333333333
        }
      ],
      "signature": "e4f06cc7d79006574508642876ee5f12b651baa4fc3f8330763a963affd17172",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "6": {
      "duration": 15.049208333333333,
      "captions": [
        {
          "text": "有两件事得先想清楚。",
          "start": 0,
          "end": 2.3300416
        },
        {
          "text": "一件是领取时间要跟闲时接得上，",
          "start": 2.3300416,
          "end": 5.1750417
        },
        {
          "text": "让顾客领完就能用；",
          "start": 5.1750417,
          "end": 6.955084
        },
        {
          "text": "定得太早或太晚，",
          "start": 6.955084,
          "end": 8.235084
        },
        {
          "text": "都接不上。",
          "start": 8.235084,
          "end": 9.375126
        },
        {
          "text": "另一件是别一次发太多，",
          "start": 9.375126,
          "end": 11.415126
        },
        {
          "text": "一下全被领走，",
          "start": 11.415126,
          "end": 12.615126
        },
        {
          "text": "闲时反而又挤满，",
          "start": 12.615126,
          "end": 14.075126
        },
        {
          "text": "白忙一场。",
          "start": 14.075126,
          "end": 15.049208333333333
        }
      ],
      "signature": "12f29e4989fb883eea3d71fc918989c0a2d9f73c6853ee708be12cbdb938ed11",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "7": {
      "duration": 7.395375,
      "captions": [
        {
          "text": "说到底，",
          "start": 0,
          "end": 1.395
        },
        {
          "text": "老周没动价目表，",
          "start": 1.395,
          "end": 3.1600416
        },
        {
          "text": "只是给闲时找了个理由——",
          "start": 3.1600416,
          "end": 5.0850415
        },
        {
          "text": "让顾客愿意挑没人的时候来。",
          "start": 5.0850415,
          "end": 7.395375
        }
      ],
      "signature": "dd11674cfa3c893df2f8491cb4e63b56730d0536793942f04e6d41dd3727f28e",
      "speaker": "zh_female_vv_uranus_bigtts"
    }
  }
}