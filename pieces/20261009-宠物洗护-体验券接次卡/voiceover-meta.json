{
  "status": "ready",
  "shots": {
    "1": {
      "duration": 11.662625,
      "captions": [
        {
          "text": "宠物店想让",
          "start": 0.0,
          "end": 1.065
        },
        {
          "text": "洗完的顾客再回来，",
          "start": 1.065,
          "end": 2.605
        },
        {
          "text": "别把体验券和次卡混着发。",
          "start": 2.605,
          "end": 5.186708333333334
        },
        {
          "text": "先解决第一次体验，",
          "start": 5.186708333333334,
          "end": 6.6967083333333335
        },
        {
          "text": "再给下次到店一个理由；",
          "start": 6.6967083333333335,
          "end": 8.761749933333334
        },
        {
          "text": "顾客确实有稳定需求后，",
          "start": 8.761749933333334,
          "end": 10.506749833333334
        },
        {
          "text": "才轮到次卡。",
          "start": 10.506749833333334,
          "end": 11.662625
        }
      ],
      "signature": "ce09c39a16307d341a5d81901527842d1c2c83d88d4f7f9cfba466321958507a",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "2": {
      "duration": 12.778541666666667,
      "captions": [
        {
          "text": "先把名字说清楚：",
          "start": 0.0,
          "end": 1.945
        },
        {
          "text": "所谓体验券，",
          "start": 1.945,
          "end": 3.3800416
        },
        {
          "text": "是给首次洗护场景用的",
          "start": 3.3800416,
          "end": 5.0550413
        },
        {
          "text": "一张优惠券，",
          "start": 5.0550413,
          "end": 6.220083
        },
        {
          "text": "不是一个和优惠券并列的新券种。",
          "start": 6.220083,
          "end": 9.100124
        },
        {
          "text": "具体做成哪种券，",
          "start": 9.100124,
          "end": 10.505124
        },
        {
          "text": "要看你真实提供的优惠内容。",
          "start": 10.505124,
          "end": 12.778541666666667
        }
      ],
      "signature": "355f87f6bbb37436e7e1c65c18b6c8f4a8dab57707dfbd7585e2751ef1504875",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "3": {
      "duration": 14.030708333333333,
      "captions": [
        {
          "text": "第一次洗完后，",
          "start": 0.0,
          "end": 1.475
        },
        {
          "text": "如果你想邀请顾客再来，",
          "start": 1.475,
          "end": 3.3800416
        },
        {
          "text": "可以另设一张",
          "start": 3.3800416,
          "end": 4.4250417
        },
        {
          "text": "用于下次洗护的优惠券，",
          "start": 4.4250417,
          "end": 6.585083
        },
        {
          "text": "把适用服务、有效期",
          "start": 6.585083,
          "end": 8.495083
        },
        {
          "text": "和使用条件写清楚。",
          "start": 8.495083,
          "end": 10.455125
        },
        {
          "text": "它要有单独目的，",
          "start": 10.455125,
          "end": 11.945126
        },
        {
          "text": "不是把次卡提前发出去。",
          "start": 11.945126,
          "end": 14.030708333333333
        }
      ],
      "signature": "8414a6a01be70682b5e4f2a0955e6fb498cd8aff9e527dcdfdda9549f133ae45",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "4": {
      "duration": 12.027875,
      "captions": [
        {
          "text": "这张券的作用，",
          "start": 0.0,
          "end": 1.435
        },
        {
          "text": "是给顾客一个",
          "start": 1.435,
          "end": 2.575
        },
        {
          "text": "再考虑到店的理由，",
          "start": 2.575,
          "end": 4.5000415
        },
        {
          "text": "不是保证他一定回来。",
          "start": 4.5000415,
          "end": 6.435083
        },
        {
          "text": "顾客有没有再次到店，",
          "start": 6.435083,
          "end": 8.095083
        },
        {
          "text": "还要看实际体验、",
          "start": 8.095083,
          "end": 9.175083
        },
        {
          "text": "宠物需求和他自己的安排。",
          "start": 9.175083,
          "end": 12.027875
        }
      ],
      "signature": "ad22923493fd901ebccce5797f06b8d792139fd2290f052915ef27c37dba5001",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "5": {
      "duration": 15.018833333333333,
      "captions": [
        {
          "text": "如果顾客又来洗，",
          "start": 0.0,
          "end": 1.925
        },
        {
          "text": "确实表现出持续需求，",
          "start": 1.925,
          "end": 4.035
        },
        {
          "text": "再介绍按次核销的洗护次卡。",
          "start": 4.035,
          "end": 6.8650413
        },
        {
          "text": "次卡要对应你",
          "start": 6.8650413,
          "end": 7.9450417
        },
        {
          "text": "实际能提供的服务，",
          "start": 7.9450417,
          "end": 9.665041
        },
        {
          "text": "按真实规则设置；",
          "start": 9.665041,
          "end": 11.255083
        },
        {
          "text": "不要拿一次体验",
          "start": 11.255083,
          "end": 12.415084
        },
        {
          "text": "就判断顾客一定需要长期购买。",
          "start": 12.415084,
          "end": 15.018833333333333
        }
      ],
      "signature": "a2b7c1340850452ec85a9d8c4b3d7b08af034f7e24fab270eb2fed2af8899698",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "6": {
      "duration": 13.593083333333333,
      "captions": [
        {
          "text": "记住这个顺序：",
          "start": 0.0,
          "end": 1.595
        },
        {
          "text": "体验券解决第一次，",
          "start": 1.595,
          "end": 3.6300416
        },
        {
          "text": "下次洗护优惠",
          "start": 3.6300416,
          "end": 4.7550416
        },
        {
          "text": "给顾客再来的理由，",
          "start": 4.7550416,
          "end": 6.550083
        },
        {
          "text": "次卡承接已经稳定的需求。",
          "start": 6.550083,
          "end": 9.225124
        },
        {
          "text": "三者不是混着发的三种名字，",
          "start": 9.225124,
          "end": 11.575125
        },
        {
          "text": "而是对应三个不同阶段。",
          "start": 11.575125,
          "end": 13.593083333333333
        }
      ],
      "signature": "eb1783f582dfe58e504cae26541141900110c0d69c4861b81701b1309920e21a",
      "speaker": "zh_female_vv_uranus_bigtts"
    }
  }
}