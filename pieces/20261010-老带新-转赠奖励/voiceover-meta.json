{
  "status": "ready",
  "shots": {
    "1": {
      "duration": 15.288291666666666,
      "captions": [
        {
          "text": "美发店想做老带新，",
          "start": 0.0,
          "end": 1.925
        },
        {
          "text": "答应给老顾客的奖励，",
          "start": 1.925,
          "end": 3.7235
        },
        {
          "text": "别在转赠那一刻就发出去。",
          "start": 3.7235,
          "end": 6.0385416
        },
        {
          "text": "老顾客把券转给朋友，",
          "start": 6.0385416,
          "end": 7.953542
        },
        {
          "text": "朋友不来核销，",
          "start": 7.953542,
          "end": 9.1435414
        },
        {
          "text": "这份奖励就白花了；",
          "start": 9.1435414,
          "end": 10.9235836
        },
        {
          "text": "等朋友到店核销，",
          "start": 10.9235836,
          "end": 12.383583000000002
        },
        {
          "text": "再把奖励给老顾客，",
          "start": 12.383583000000002,
          "end": 13.963583
        },
        {
          "text": "这一单才算数。",
          "start": 13.963583,
          "end": 15.288291666666666
        }
      ],
      "signature": "f9193ed6a053b5035efa8c97ace35ddfd9bd4a92af7207a111ae90ac492a60a3",
      "captionSignature": "4d016e43c2295ccf17345a53c7638e5daadcadcb805836ba5a15085ee581a679",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "2": {
      "duration": 12.226791666666667,
      "captions": [
        {
          "text": "做起来就三步：",
          "start": 0.0,
          "end": 1.695
        },
        {
          "text": "先打开允许转赠，",
          "start": 1.695,
          "end": 3.7400417
        },
        {
          "text": "再开启转赠奖励，",
          "start": 3.7400417,
          "end": 5.415042
        },
        {
          "text": "奖励券挑一张私密发放的。",
          "start": 5.415042,
          "end": 7.845083
        },
        {
          "text": "朋友到店核销之后，",
          "start": 7.845083,
          "end": 9.375083
        },
        {
          "text": "奖励券会发给",
          "start": 9.375083,
          "end": 10.495083
        },
        {
          "text": "转赠它的那位老顾客。",
          "start": 10.495083,
          "end": 12.226791666666667
        }
      ],
      "signature": "6ab77fba43e23349bac9edfc1528540f5be795609e43135a7c981a9afbc353c2",
      "captionSignature": "0965530ba688359496b32a1481cc7ed076a6a9bb87d37a0d45a43bfa0d412bda",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "3": {
      "duration": 13.587666666666667,
      "captions": [
        {
          "text": "券转出去之后是",
          "start": 0.0,
          "end": 1.815
        },
        {
          "text": "「转赠中」状态：",
          "start": 1.815,
          "end": 3.375
        },
        {
          "text": "老顾客不能自己先核销掉，",
          "start": 3.375,
          "end": 5.6700416
        },
        {
          "text": "也随时可以取消；",
          "start": 5.6700416,
          "end": 7.1900835
        },
        {
          "text": "领取时只有第一位朋友",
          "start": 7.1900835,
          "end": 8.915084
        },
        {
          "text": "才能领到券。",
          "start": 8.915084,
          "end": 10.190125
        },
        {
          "text": "奖励券是私密发放的，",
          "start": 10.190125,
          "end": 12.125126
        },
        {
          "text": "不会公开被领走。",
          "start": 12.125126,
          "end": 13.587666666666667
        }
      ],
      "signature": "044a304617824a79973666d1d151b45d7f7e573897a10dd07ca87d60fff60808",
      "captionSignature": "bf9731cf56717de991fe3ce415815c54c31dc337f74cef33a7f7c01c52c531c6",
      "speaker": "zh_female_vv_uranus_bigtts"
    },
    "4": {
      "duration": 11.805916666666667,
      "captions": [
        {
          "text": "奖励发回给转赠的老顾客：",
          "start": 0.0,
          "end": 2.545
        },
        {
          "text": "谁把人带进来，",
          "start": 2.545,
          "end": 3.625
        },
        {
          "text": "奖励给谁。",
          "start": 3.625,
          "end": 4.5900416
        },
        {
          "text": "朋友不来核销，",
          "start": 4.5900416,
          "end": 5.6450415
        },
        {
          "text": "奖励就不会发出去。",
          "start": 5.6450415,
          "end": 7.335083
        },
        {
          "text": "它不保证人人都来，",
          "start": 7.335083,
          "end": 8.845083
        },
        {
          "text": "但能让每一份奖励",
          "start": 8.845083,
          "end": 10.085083
        },
        {
          "text": "都对上一次真到店。",
          "start": 10.085083,
          "end": 11.805916666666667
        }
      ],
      "signature": "9e18cc60c94e9a3feaa9ffcfadfee09cfe19d37712b57eed03f94ded47e1014e",
      "captionSignature": "ee49d79e6069b86815c6e88a3a3c067f2a2208b92f659f24af476ce2c320ff6f",
      "speaker": "zh_female_vv_uranus_bigtts"
    }
  }
}